## 5. Database Schema (Supabase PostgreSQL)

```sql
CREATE TABLE members (
  id                 TEXT PRIMARY KEY,
  name               TEXT NOT NULL,
  divisi             TEXT NOT NULL,
  angkatan           TEXT,
  email              TEXT UNIQUE,
  nim                TEXT UNIQUE,
  phone              TEXT,
  is_active          BOOLEAN DEFAULT TRUE,
  barcode_expires_at DATE,
  created_at         TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE classes (
  id          UUID DEFAULT gen_random_uuid() PRIMARY KEY,
  name        TEXT NOT NULL,
  divisi      TEXT NOT NULL,
  date        DATE NOT NULL,
  start_time  TIME NOT NULL,
  end_time    TIME NOT NULL,
  location    TEXT,
  created_by  UUID REFERENCES auth.users(id),
  created_at  TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE attendances (
  id          UUID DEFAULT gen_random_uuid() PRIMARY KEY,
  class_id    UUID REFERENCES classes(id) ON DELETE CASCADE,
  member_id   TEXT REFERENCES members(id) ON DELETE CASCADE,
  status      TEXT DEFAULT 'hadir' CHECK (status IN ('hadir', 'izin', 'sakit')),
  method      TEXT DEFAULT 'barcode' CHECK (method IN ('barcode', 'manual')),
  notes       TEXT,
  scanned_at  TIMESTAMPTZ DEFAULT NOW(),
  scanned_by  UUID REFERENCES auth.users(id),
  UNIQUE(class_id, member_id)
);

CREATE TABLE profiles (
  id         UUID REFERENCES auth.users(id) PRIMARY KEY,
  name       TEXT,
  role       TEXT DEFAULT 'operator' CHECK (role IN ('admin', 'operator', 'member')),
  divisi     TEXT,
  created_at TIMESTAMPTZ DEFAULT NOW()
);

-- Indexes
CREATE INDEX idx_attendances_class_id ON attendances(class_id);
CREATE INDEX idx_attendances_member_id ON attendances(member_id);
CREATE INDEX idx_classes_date ON classes(date);
CREATE INDEX idx_members_divisi ON members(divisi);
```

### Row Level Security (RLS)

```sql
ALTER TABLE members ENABLE ROW LEVEL SECURITY;
ALTER TABLE classes ENABLE ROW LEVEL SECURITY;
ALTER TABLE attendances ENABLE ROW LEVEL SECURITY;
ALTER TABLE profiles ENABLE ROW LEVEL SECURITY;

CREATE POLICY "members_select" ON members FOR SELECT TO authenticated USING (true);
CREATE POLICY "members_write" ON members FOR ALL TO authenticated
  USING (EXISTS (SELECT 1 FROM profiles WHERE id = auth.uid() AND role IN ('admin','operator')));

CREATE POLICY "classes_select" ON classes FOR SELECT TO authenticated USING (true);
CREATE POLICY "classes_write" ON classes FOR ALL TO authenticated
  USING (EXISTS (SELECT 1 FROM profiles WHERE id = auth.uid() AND role IN ('admin','operator')));

CREATE POLICY "attend_select" ON attendances FOR SELECT TO authenticated USING (true);
CREATE POLICY "attend_write" ON attendances FOR ALL TO authenticated
  USING (EXISTS (SELECT 1 FROM profiles WHERE id = auth.uid() AND role IN ('admin','operator')));
```

---

## 6. Alur Scan Absen

1. Admin buka `/scan`, pilih kelas aktif
2. Scanner baca barcode Code 128 via `@ericblade/quagga2`
3. Validasi `isMemberIDValid(code)` — tolak jika tidak valid
4. Ambil data member dari Supabase
5. Cek `isBarcodeExpired(member.barcode_expires_at)` — tolak jika expired
6. Cek apakah `member.divisi === class.divisi` — tolak jika tidak sesuai
7. Insert ke tabel `attendances`
8. Jika error `23505` (duplicate), tampilkan "Sudah tercatat hadir"
9. Supabase Realtime broadcast update ke semua device yang terhubung

